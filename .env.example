# PETRAPMS Frontend — environment variables
# Copy to .env.local

# When true (default for Phase 1), the app runs entirely against
# lib/mock-data.ts — no backend needed. Flip to false and set
# NEXT_PUBLIC_API_URL once the Phase 2 (backend) session is ready,
# per PETRAPMS-CONTRACT.md.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:3001
